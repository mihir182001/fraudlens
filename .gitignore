.venv/
__pycache__/
*.pyc
.pytest_cache/

# Real Kaggle data is large and must never be committed, see
# src/data/generate_synthetic_ieee.py's module docstring for why the
# sandbox this was built in uses synthetic stand-ins instead.
data/raw/*.csv
data/processed/*.csv
data/processed/*.json
.env

# MLflow's local sqlite tracking database and any run artifacts it writes
# are local experiment history, not code, and are regenerated by running
# src/models/baseline_models.py again.
mlflow.db
mlartifacts/
mlruns/

# Trained serving artifacts (src/serving/train_serving_models.py) and the
# risk decision audit log (src/serving/audit_log.py) are the same kind of
# thing as mlflow.db above: regenerable local output, not code, and in
# these two cases also binary, which git handles poorly. Committing them
# would also defeat docker-compose.yml's own design, which bind-mounts
# these exact paths from the host specifically so a container never needs
# its own copy baked in.
models/*.joblib
audit_log.db
